DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=grouphome
JWT_SECRET=replace_this_with_a_32_character_random_string
PORT=3000
NODE_ENV=development

# Cookie signing — min 32 chars, keep secret, never commit
COOKIE_SECRET=replace_this_with_a_32_character_random_string

# Frontend base URL — used in email links
APP_URL=http://localhost:5173

# Resend — transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin panel — credentials stored in .env only, never in DB
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=replace_this_with_a_different_32_character_string

# DocuSign BAA — leave blank to skip BAA and activate orgs immediately
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_WEBHOOK_SECRET=
